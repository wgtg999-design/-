# Vercel Project → Settings → Environment Variables에 실제 값을 등록하세요.
# 이 파일은 이름 안내입니다. 비밀값이나 회원/주문 백업을 Git에 넣지 마세요.
NEXT_PUBLIC_SITE_URL=
# This checkout is an explicitly labelled prototype. Use live only with actual operating policies and service setup.
STORE_SITE_MODE=test
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
UPLOAD_SIGNING_SECRET=
OWNER_BOOTSTRAP_EMAIL=

# AI 가상 피팅 (기능 기본 비활성화, 실제 값은 서버 환경변수에만 등록)
FASHN_API_KEY=
# 서로 다른 32바이트 이상의 임의 비밀값. NEXT_PUBLIC_ 접두어를 붙이지 마세요.
TRYON_SIGNING_SECRET=
CRON_SECRET=
